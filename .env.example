# Lekta: kanonski popis environment varijabli.
#
# SAMO IMENA I OBJASNJENJA, NIJEDNA VRIJEDNOST. Kopiraj u `.env` (koji je gitignoriran) i popuni.
# Nikad ne upisuj stvarnu tajnu u ovu datoteku: ona je u repozitoriju.
#
# Audit 2026-08-17 (CODE-11) prijavio je da sablona ne postoji: `.gitignore` je uzorkom `.env.*`
# pojeo i nju, pa novi developer nije imao odakle znati sto treba postaviti. Pravilo "nikad tajne
# u repo" ostaje, ali sada uz izuzetak za ovu datoteku.
#
# Legenda:
#   [klijent]  ugradjuje se u JS bundle pri buildu, dakle JAVNO je. Nikad tajna.
#   [server]   cita ga Deno Edge funkcija ili skripta. Smije biti tajna.
#   [build]    cita ga build ili pomocna skripta na tvom stroju / u CI-ju.


# ---------------------------------------------------------------------------------------------
# Klijent (Vite). Sve VITE_* varijable zavrsavaju u javnom bundleu.
# ---------------------------------------------------------------------------------------------

# [klijent] Supabase projekt na koji se aplikacija spaja.
# BEZ NJIH `src/config/deployment.ts` pada na produkcijski projekt, pa `npm run dev` cita i pise
# ZIVU produkciju (audit A26-07). Za lokalni rad ih uvijek postavi.
VITE_LEKTA_SUPABASE_URL=
VITE_LEKTA_SUPABASE_ANON_KEY=

# [klijent] Okruzenje: 'production' | 'staging'. Staging bez gornjih varijabli namjerno pada.
VITE_LEKTA_ENV=

# [klijent] Sestrinski proizvod Katedra (jednosmjeran izvoz podataka iz Lekte).
VITE_KATEDRA_URL=
VITE_COMPLETION_CHECK_ENDPOINT=


# ---------------------------------------------------------------------------------------------
# Supabase, serverska strana. Service role kljuc je NAJOSJETLJIVIJA tajna u projektu:
# zaobilazi RLS u cijelosti. Nikad ga ne stavljaj u klijent ni u VITE_* varijablu.
# ---------------------------------------------------------------------------------------------

# [server] Postavlja ih Supabase runtime za Edge funkcije; lokalno ih trebas za skripte.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# [build] Osobni pristupni token za Management API (`supabase` CLI, deploy-drift,
# migration-identity). Nije isto sto i service role kljuc.
SUPABASE_ACCESS_TOKEN=

# [build] Project refovi za dijagnosticke skripte. Namjerno NISU u kodu: hardkodiran produkcijski
# ref bio je jedan od nalaza audita (DB-02).
LEKTA_PROD_REF=
LEKTA_STAGING_REF=

# [server] Sol za hashiranje IP-a. Bez nje se izvodi stabilna sol iz service role kljuca, pa
# ip_hash nikad nije nesoljen, ali dedicirana je vrijednost bolja.
IP_HASH_SALT=

# [server] Porijekla kojima Edge funkcije dopustaju CORS (zarezom odvojeno).
ALLOWED_ORIGIN=

# [server] Dopusti CORS s localhosta. Postavi na 1 SAMO za lokalni razvoj, NIKAD u produkciji
# (audit SEC-11): inace bilo koja lokalna aplikacija na korisnikovu racunalu moze zvati
# produkcijske funkcije iz njegovog preglednika.
LEKTA_ALLOW_LOCALHOST_CORS=


# ---------------------------------------------------------------------------------------------
# Naplata (Merchant of Record: Lemon Squeezy).
# ---------------------------------------------------------------------------------------------

# [server] Tajna za provjeru HMAC potpisa webhooka.
MOR_WEBHOOK_SECRET=

# [server] ID nase trgovine. OBAVEZNO: bez njega `webhook-mor` odbija SVE dogadjaje s razlogom
# `store_unverifiable` (audit PAY-04). To je namjerno fail-closed, jer potpis dokazuje samo
# znanje tajne, ne i cija je trgovina.
LS_STORE_ID=

# [server] Dopusti dogadjaje iz TESTNOG nacina rada (1 = dopusti). U produkciji ostaje prazno,
# inace testna kupnja proizvodi pravo pravo pristupa (audit PAY-05).
LS_ALLOW_TEST_MODE=

# [server] Lemon Squeezy API pristup i preusmjeravanje nakon kupnje.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
CHECKOUT_REDIRECT_URL=
CHECKOUT_DAILY_CAP=

# [build] Origin checkout hosta za CSP `form-action`. Prije je tu bio wildcard
# `https://*.lemonsqueezy.com` (audit SEC-02).
LEKTA_LS_CHECKOUT_ORIGIN=

# [build] Naplata je ZIVA. Kad je 1, `verify-deploy-dist` ODBIJA deploy ako
# `data/legal/provider.json` nema OIB, adresu, telefon i voditelja obrade (audit A26-01).
LEKTA_COMMERCE_LIVE=


# ---------------------------------------------------------------------------------------------
# Popravak dokumenata (placeni proizvod).
# ---------------------------------------------------------------------------------------------

# [server] Kill switch i granice. REPAIR_FREE_MODE = besplatna beta bez entitlementa.
REPAIR_DISABLED=
REPAIR_FREE_MODE=
REPAIR_MAX_DOCX_BYTES=
REPAIR_MAX_CONCURRENT=
REPAIR_FREE_DAILY_CAP=
REPAIR_FREE_IP_DAILY_CAP=
REPAIR_STORAGE_DAILY_CAP=
REPAIR_ANON_RETENTION_DAYS=

# [server] Ciscenje sirocih Storage objekata (cron). Dedicirana tajna, NIKAD service role.
REPAIR_CLEANUP_CRON_SECRET=
REPAIR_CLEANUP_GRACE_MINUTES=

# [server] LibreOffice worker za render Wordovih polja.
FIELD_RENDER_WORKER_URL=
FIELD_RENDER_WORKER_TOKEN=
FIELD_RENDER_MAX_BYTES=
FIELD_RENDER_TIMEOUT_MS=


# ---------------------------------------------------------------------------------------------
# Provjera prije predaje (preflight). UGASENO u produkciji 2026-08-17: obje Edge funkcije su
# undeployane (vidi docs/deploy/PREFLIGHT_DEPLOY.md). Varijable ostaju za buduce paljenje.
# ---------------------------------------------------------------------------------------------

PREFLIGHT_DISABLED=
PREFLIGHT_SERVICE_URL=
PREFLIGHT_UPLOAD_SECRET=
PREFLIGHT_MAX_UPLOAD_MB=
PREFLIGHT_MAX_REFS=
PREFLIGHT_DAILY_CAP_USER=
PREFLIGHT_DAILY_CAP_IP=
PREFLIGHT_REQUIRE_ENTITLEMENT=


# ---------------------------------------------------------------------------------------------
# Rokovi i e-mail (Resend).
# ---------------------------------------------------------------------------------------------

RESEND_API_KEY=
REMINDER_FROM_EMAIL=
REMINDER_CRON_SECRET=
REMINDER_UNSUB_SECRET=
APP_BASE_URL=


# ---------------------------------------------------------------------------------------------
# Provjera izvora i integritet (vanjski provideri).
# ---------------------------------------------------------------------------------------------

SOURCE_CHECK_USER_DAILY_CAP=
SOURCE_CHECK_IP_DAILY_CAP=
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
AI_DETECTOR_API_URL=
AI_DETECTOR_API_KEY=
INTEGRITY_TEASER_DAILY_CAP=
INTEGRITY_TEASER_DAILY_CAP_IP=
INTEGRITY_FULL_DAILY_CAP=
INTEGRITY_FULL_DAILY_CAP_IP=
INTEGRITY_PROVIDER_TIMEOUT_MS=


# ---------------------------------------------------------------------------------------------
# Katedra agentski worker.
# ---------------------------------------------------------------------------------------------

KATEDRA_AGENT_WORKER_TOKEN=
KATEDRA_AGENT_WORKER_CRON_SECRET=
KATEDRA_AGENT_WORKER_BATCH=
KATEDRA_WORKER_APP_URL=


# ---------------------------------------------------------------------------------------------
# Build i pomocni alati.
# ---------------------------------------------------------------------------------------------

# [build] Javni origin sajta (kanonik, sitemap, OG). Staging ima svoj.
LEKTA_SITE_ORIGIN=

# ---------------------------------------------------------------------------------------------
# Release i deploy vrata. Ove tri gate-aju objavu, a do 2026-08-30 nisu bile nigdje popisane:
# citale su ih samo skripte, pa je operater vidio poruku o varijabli koju nema gdje procitati.
# ---------------------------------------------------------------------------------------------

# [release] Origin STAGINGA za `scripts/extraction-probe.mjs` (Tier 2 u `npm run release:check`).
# Bez nje je ta razina `unavailable`, a kako je `required`, dokaz o provjerama ostaje NEPOTPUN
# (`complete: false`) i deploy s tvrdim gateom pada. Smije biti iskljucivo staging: skripta
# izricito odbija produkcijski host.
LEKTA_STAGING_ORIGIN=

# [deploy] Kad je "1", `scripts/verify-deploy-dist.mjs` TVRDO pada bez svjezeg
# `docs/generated/RELEASE_PROOF.json` vezanog uz commit koji se gradi; inace samo upozorava.
# Namjerno nije bezuvjetno: prvi deploy bi inace pao dok se ne odvrti visesatni lanac.
# `netlify.toml` na `masteru` je postavlja, pa je ondje gate vec tvrd.
LEKTA_REQUIRE_RELEASE_PROOF=

# [deploy] Beta placenog popravka. Prag se izvodi i iz ONOGA STO SE ISPORUCUJE, pa `shipped.repair`
# sam po sebi diže prag i bez ove zastavice; sluzi za izricito ukljucivanje.
LEKTA_REPAIR_LIVE=

# [build] Ostalo: analitika, lokalni korpus, ffmpeg za demo video.
ANALYTICS_DAILY_CAP_IP=
DAILY_CAP=
LEKTA_LOCAL_CORPUS=
SUPABASE_ENV_FILE=
FFMPEG=
