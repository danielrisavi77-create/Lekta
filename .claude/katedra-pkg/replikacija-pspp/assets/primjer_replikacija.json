{
  "naslov": "Financijska pismenost mladih u Hrvatskoj kao oblik ekonomskog građanstva",
  "baza": "podaci/baza.csv",
  "izlaz": "replikacija",
  "oznake": {
    "dob": "Dob",
    "obrazovanje": "Obrazovanje",
    "prihod": "Prihod",
    "mat_status": "Mat. status",
    "FL": "Fin. pism. (0-8)",
    "edu_dovoljno": "Dostatnost obrazov.",
    "ima_instrument": "Ima instr.",
    "planira": "Namjera",
    "znanje_kamata": "Složena kamata",
    "znanje_inflacija": "Inflacija",
    "znanje_eks": "EKS",
    "znanje_depoziti": "Osiguranje depozita",
    "znanje_diverz": "Diverzifikacija",
    "znanje_etf": "Indeksni fondovi",
    "znanje_kripto": "Kriptovalute",
    "znanje_stup3": "III. stup",
    "individualna_odgovornost": "Ind. odgov.",
    "etatisticka_orijentacija": "Etatiz. orij.",
    "trzisna_participacija": "Tržiš. partic.",
    "gradanska_dimenzija": "Građan. dim.",
    "strukturna_atribucija": "Strukt. atrib.",
    "EG_kompozit": "EG komp.",
    "P28": "Sami odgovorni",
    "P29": "Država jamči standard",
    "P30": "Tržišta prevelik utj.",
    "P31": "Ulaganje = kontrola",
    "P32": "Tko ne štedi, snosi",
    "P33": "Stroža regulacija",
    "P34": "Okolnosti prije odluka",
    "P35": "Bez ulaganja nema st.",
    "P36": "Pismenost u školama",
    "P37": "Briga = građanska duž.",
    "P38": "Uspjeh = trud",
    "P39": "Regulacija šteti"
  },
  "priprema": "REGRESSION /VARIABLES=dob /DEPENDENT=FL /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=planira /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=mat_status /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=prihod /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=EG_kompozit /METHOD=ENTER /SAVE RESID.\nVARIABLE LABELS RES1 'FL bez dobi' RES2 'Namjera bez dobi' RES3 'Mat. status bez dobi'\n  RES4 'Prihod bez dobi' RES5 'EG komp. bez dobi'.\nSAVE OUTFILE='reziduali_bez_dobi.sav'.",
  "analize": [
    {
      "ime": "01_deskriptiva",
      "sirina": 1180,
      "natpis": "Deskriptivna statistika dobi i indeksa financijske pismenosti",
      "sintaksa": "DESCRIPTIVES /VARIABLES=dob FL /STATISTICS=MEAN STDDEV MIN MAX.\nFREQUENCIES /VARIABLES=FL /STATISTICS=MEDIAN."
    },
    {
      "ime": "02_frekvencije",
      "sirina": 1180,
      "natpis": "Frekvencije ocjene obrazovanja, posjedovanja instrumenta i namjere ulaganja",
      "sintaksa": "FREQUENCIES /VARIABLES=edu_dovoljno ima_instrument planira."
    },
    {
      "ime": "03_pouzdanost_znanje",
      "sirina": 1000,
      "natpis": "Analiza pouzdanosti osam čestica znanja",
      "sintaksa": "RELIABILITY /VARIABLES=znanje_kamata znanje_inflacija znanje_eks znanje_depoziti\n  znanje_diverz znanje_etf znanje_kripto znanje_stup3 /MODEL=ALPHA."
    },
    {
      "ime": "04_pouzdanost_ljestvice",
      "sirina": 1000,
      "natpis": "Analiza pouzdanosti ljestvica stavova",
      "sintaksa": "RELIABILITY /VARIABLES=P28 P32 P38 /MODEL=ALPHA.\nRELIABILITY /VARIABLES=P29 P33 /MODEL=ALPHA.\nRELIABILITY /VARIABLES=P31 P35 /MODEL=ALPHA.\nRELIABILITY /VARIABLES=P30 P34 /MODEL=ALPHA.\nRELIABILITY /VARIABLES=P36 P37 /MODEL=ALPHA."
    },
    {
      "ime": "05_korelacije",
      "sirina": 1460,
      "natpis": "Korelacije indeksa financijske pismenosti s ostalim varijablama",
      "sintaksa": "CORRELATIONS /VARIABLES=FL WITH planira ima_instrument individualna_odgovornost\n  etatisticka_orijentacija /PRINT=TWOTAIL SIG.\nCORRELATIONS /VARIABLES=FL WITH mat_status prihod EG_kompozit gradanska_dimenzija dob\n  /PRINT=TWOTAIL SIG."
    },
    {
      "ime": "06_t_test",
      "sirina": 1460,
      "natpis": "T-test za nezavisne uzorke prema namjeri ulaganja",
      "sintaksa": "T-TEST /GROUPS=planira(0 1) /VARIABLES=FL."
    },
    {
      "ime": "07_upareni_t_test",
      "sirina": 1460,
      "natpis": "T-test za zavisne uzorke, suvremeni i tradicionalni sadržaji",
      "sintaksa": "COMPUTE suvremeni = (znanje_etf + znanje_kripto) / 2.\nCOMPUTE tradicionalni = (znanje_kamata + znanje_depoziti) / 2.\nEXECUTE.\nT-TEST /PAIRS=suvremeni WITH tradicionalni (PAIRED)."
    },
    {
      "ime": "08_anova",
      "sirina": 1380,
      "natpis": "Analiza varijance po razini obrazovanja",
      "sintaksa": "TEMPORARY.\nSELECT IF (obrazovanje NE 1).\nONEWAY FL BY obrazovanje /STATISTICS=DESCRIPTIVES."
    },
    {
      "ime": "09_parcijalne",
      "sirina": 1300,
      "natpis": "Parcijalne korelacije uz kontrolu dobi",
      "sintaksa": "REGRESSION /VARIABLES=dob /DEPENDENT=FL /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=planira /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=mat_status /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=prihod /METHOD=ENTER /SAVE RESID.\nREGRESSION /VARIABLES=dob /DEPENDENT=EG_kompozit /METHOD=ENTER /SAVE RESID.\nVARIABLE LABELS RES1 'FL bez dobi' RES2 'Namjera bez dobi' RES3 'Mat. status bez dobi'\n  RES4 'Prihod bez dobi' RES5 'EG komp. bez dobi'.\nCORRELATIONS /VARIABLES=RES1 WITH RES2 RES3 RES4 RES5 /PRINT=TWOTAIL SIG.",
      "sintaksa_snimka": "GET FILE='reziduali_bez_dobi.sav'.\nCORRELATIONS /VARIABLES=RES1 WITH RES2 RES3 RES4 RES5 /PRINT=TWOTAIL SIG."
    },
    {
      "ime": "10_glavne_komponente",
      "sirina": 1200,
      "natpis": "Analiza glavnih komponenti",
      "sintaksa": "FACTOR /VARIABLES=P28 P29 P30 P31 P32 P33 P34 P35 P36 P37 P38 P39\n  /EXTRACTION=PC /CRITERIA=MINEIGEN(1) /ROTATION=NOROTATE\n  /PRINT=INITIAL EXTRACTION."
    }
  ],
