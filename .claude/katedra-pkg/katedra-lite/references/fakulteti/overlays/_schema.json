{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Katedra compositional profile overlay",
  "type": "object",
  "required": [
    "id",
    "level",
    "match",
    "rules",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "level": {
      "enum": [
        "global",
        "institution",
        "programme",
        "work_type",
        "course",
        "mentor"
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": {
          "type": "string"
        },
        "faculty": {
          "type": "string"
        },
        "programme": {
          "type": "string"
        },
        "work_type": {
          "type": "string"
        },
        "course": {
          "type": "string"
        },
        "mentor": {
          "type": "string"
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/definitions/provenanceEntry"
        },
        "rules": {
          "type": "object",
          "patternProperties": {
            "^/": {
              "$ref": "#/definitions/provenanceEntry"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "definitions": {
    "provenanceEntry": {
      "type": "object",
      "required": [
        "source",
        "type",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string"
        },
        "type": {
          "enum": [
            "explicit",
            "derived",
            "default",
            "inferred",
            "project_override"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verified_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "derivation": {
          "type": "string"
        }
      }
    }
  }
}
