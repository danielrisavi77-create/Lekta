{
  "schemaVersion": 1,
  "repository": "danielrisavi77-create/Lekta",
  "baseBranch": "master",
  "mode": "observe",
  "billingMode": "subscription_only",
  "allowApiBilling": false,
  "allowPaidCredits": false,
  "maxPaidActionsUsd": 0,
  "allowedRunnerClass": "public_standard",
  "maxConcurrentJobs": 1,
  "maxNewJobsPerDay": 3,
  "maxAttemptsPerTask": 2,
  "agentTimeoutMinutes": 30,
  "gateTimeoutMinutes": 120,
  "pollMinutes": 60,
  "maxOpenAutonomyPrs": 2,
  "maxFilesPerAutoChange": 5,
  "maxChangedLinesPerAutoChange": 200,
  "localLogRetentionDays": 14,
  "artifactRetentionDays": 7,
  "maxSuccessfulAutoDeploysPerDay": 1,
  "providerFallback": "wait",
  "fableEnabled": false,
  "externalDocumentUploadAllowed": false,
  "publisherEnabled": false,
  "policyVersion": "2026-09-09.1",
  "autoLowRiskPathPrefixes": ["docs/", "src/ui/", "src/routes/", "tests/ux/"],
  "requiredReleaseTiers": ["check", "conformance", "slow", "ux", "strict-open", "word", "word-worst"],
  "signalSources": [
    { "id": "inbox", "kind": "inbox" },
    { "id": "ci", "kind": "github_ci", "workflows": ["check", "ux-gate", "post-deploy-smoke"] }
  ]
}
