{
  "name": "lekta",
  "private": true,
  "version": "2.2.2",
  "type": "module",
  "description": "Lekta - klijentska provjera akademskih radova prema profilima zagrebackih visokih ucilista.",
  "scripts": {
    "bootstrap": "node scripts/split-prototype.mjs",
    "extract-data": "node scripts/extract-data.mjs",
    "discovery": "node discovery/ingest.mjs && node discovery/generate-coverage.mjs",
    "demand-signal": "node discovery/demand-signal.mjs",
    "notify-covered": "node discovery/notify-covered.mjs",
    "recompute-coverage": "node scripts/recompute-coverage.mjs",
    "apply-verification": "node scripts/apply-verification.mjs",
    "dossier": "node scripts/verification-dossier.mjs",
    "generate-citation-tools": "node scripts/generate-citation-tools.mjs",
    "generate-legal-pages": "node scripts/generate-legal-pages.mjs",
    "extract-citation-sections": "node scripts/extract-citation-sections.mjs",
    "citation-dossiers": "node scripts/citation-spec-dossier.mjs",
    "approve-citation-spec": "node scripts/approve-citation-spec.mjs",
    "docx-smoke": "vite-node scripts/docx-smoke.mts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "check": "tsc --noEmit && vitest run && vite build"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "netlify-cli": "^26.2.0",
    "supabase": "^2.109.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@xmldom/xmldom": "^0.9.10",
    "canvas-confetti": "^1.9.4",
    "lucide": "^1.24.0",
    "motion": "^12.42.2",
    "open-props": "^1.7.23"
  }
}
