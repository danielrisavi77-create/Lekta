{
  "name": "lekta",
  "private": true,
  "version": "2.2.2",
  "description": "Lekta - klijentska provjera akademskih radova prema profilima zagrebackih visokih ucilista.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielrisavi77-create/Lekta.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.11.0",
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/split-prototype.mjs",
    "extract-data": "node scripts/extract-data.mjs",
    "discovery": "node discovery/ingest.mjs && node discovery/generate-coverage.mjs",
    "demand-signal": "node discovery/demand-signal.mjs",
    "notify-covered": "node discovery/notify-covered.mjs",
    "recompute-coverage": "node scripts/recompute-coverage.mjs",
    "gen-corpus-stats": "node scripts/gen-corpus-stats.mjs",
    "apply-verification": "node scripts/apply-verification.mjs",
    "dossier": "node scripts/verification-dossier.mjs",
    "generate-citation-tools": "node scripts/generate-citation-tools.mjs",
    "generate-legal-pages": "node scripts/generate-legal-pages.mjs",
    "generate-coverage-page": "node scripts/generate-coverage-page.mjs",
    "generate-faculty-pages": "node scripts/generate-faculty-pages.mjs",
    "generate-title-page-tools": "node scripts/generate-title-page-tools.mjs",
    "generate-competitor-pages": "node scripts/generate-competitor-pages.mjs",
    "extract-citation-sections": "node scripts/extract-citation-sections.mjs",
    "citation-dossiers": "vite-node scripts/citation-spec-dossier.mts",
    "approve-citation-spec": "node scripts/approve-citation-spec.mjs",
    "gen:worktype-scope": "node scripts/generate-work-type-scope.mjs",
    "docx-smoke": "vite-node scripts/docx-smoke.mts",
    "corpus:inventory": "vite-node tests/corpus/cli/inventory.ts",
    "corpus:coverage": "vite-node tests/corpus/cli/coverage.ts",
    "corpus:export": "vite-node tests/corpus/cli/export.ts",
    "test:corpus": "vitest run tests/corpus-inventory.test.ts tests/corpus-ids.test.ts tests/corpus-atomic.test.ts tests/corpus-valid-controls.test.ts tests/corpus-boundary.test.ts tests/corpus-coverage.test.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ux": "playwright test --project=chromium --project=mobile-chromium",
    "test:ux:browsers": "playwright test --project=firefox --project=webkit --project=mobile-webkit",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "check": "oxlint && tsc --noEmit && npm run check:edge && vitest run && vite build",
    "master-ci": "node scripts/master-ci-status.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "smoke:db": "psql -v ON_ERROR_STOP=1 -f scripts/rate-slots-smoke.sql && psql -v ON_ERROR_STOP=1 -f scripts/guarantee-evidence-smoke.sql && psql -v ON_ERROR_STOP=1 -f scripts/repair-deletion-smoke.sql && psql -v ON_ERROR_STOP=1 -f scripts/anon-purge-smoke.sql && psql -v ON_ERROR_STOP=1 -f scripts/bonus-outbox-smoke.sql && psql -v ON_ERROR_STOP=1 -f scripts/client-errors-smoke.sql",
    "smoke:db:mutation": "bash scripts/rate-slots-mutation-check.sh",
    "check:full": "npm run check && npm run test:slow",
    "release:check": "node scripts/release-check.mjs",
    "tier2-freshness": "node scripts/tier2-freshness.mjs",
    "projection-freshness": "node scripts/projection-freshness.mjs",
    "projection-verify": "node scripts/projection-verify.mjs",
    "verify:strict-open": "python scripts/verify-docx/strict-open.py tests/fixtures/docx",
    "verify:strict-open:repaired": "npm run repair-real-corpus:review && python scripts/verify-docx/strict-open.py .artifacts/lekta-real-corpus-review",
    "verify:word": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/check.ps1",
    "verify:word:worst": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/check-worst-case.ps1",
    "verify:word:corpus": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/check-corpus.ps1",
    "deploy-drift": "node scripts/deploy-drift.mjs",
    "orphan-scan": "node scripts/orphan-scan.mjs",
    "migration-identity": "node scripts/migration-identity.mjs",
    "gen-site-stats": "vite-node scripts/gen-site-stats.mts",
    "gen-profile-rules-server": "vite-node scripts/gen-profile-rules-server.mts",
    "repair-recipe": "vite-node scripts/generate-repair-recipe.mts && vite-node scripts/gen-profile-rules-server.mts",
    "deploy:profile-rules": "node scripts/deploy-profile-rules.mjs",
    "repair-coverage": "vite-node scripts/generate-repair-coverage.mts",
    "corpus-gen:libreoffice": "node scripts/corpus-gen/libreoffice.mjs",
    "repair-real-corpus": "vite-node scripts/repair-real-corpus.mts",
    "repair-real-corpus-backlog": "vite-node scripts/generate-real-corpus-backlog.mts",
    "repair-real-corpus:review": "vite-node scripts/repair-real-corpus.mts --out .artifacts/lekta-real-corpus-review",
    "repair-faculty-matrix": "vite-node scripts/generate-faculty-matrix.mts",
    "pack:katedra": "vite-node scripts/generate-katedra-pack.mts",
    "generate-benchmark-fixture": "vite-node scripts/generate-benchmark-fixture.mts",
    "verify:word:toc": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/make-toc-case.ps1 && vite-node scripts/word-verify/repair-toc.mts -- .tmp-word-verify/toc-slucaj.docx .tmp-word-verify/toc-slucaj-popravljen.docx && powershell -ExecutionPolicy Bypass -File scripts/word-verify/check-toc-case.ps1",
    "worklist": "vite-node scripts/verification-worklist.mts",
    "scored-value-drift": "vite-node scripts/generate-scored-value-drift.mts",
    "drift-adjudicate": "python scripts/adjudicate_drift.py",
    "drift-apply": "node scripts/apply-drift-decision.mjs",
    "drift-dossiers": "vite-node scripts/generate-drift-dossiers.mts",
    "claim-modality": "python scripts/propose_claim_modality.py",
    "claim-modality:selftest": "python scripts/propose_claim_modality.py --selftest",
    "claim-modality:apply": "python scripts/apply_claim_modality.py --write",
    "claim-scope": "node scripts/apply-claim-scope.mjs",
    "audit:scored-quotes": "python scripts/audit_scored_quotes.py",
    "audit:selftest": "python scripts/audit_scored_quotes.py --selftest",
    "verify:claims": "python scripts/verify_rule_claims.py",
    "verify:claims:selftest": "python scripts/verify_rule_claims.py --selftest",
    "verify:source-hashes": "node scripts/verify-source-hashes.mjs",
    "completion-ledger": "vite-node scripts/generate-completion-ledger.mts",
    "gen-profile-claims": "vite-node scripts/gen-profile-claims.mts",
    "citation-claim-coverage": "vite-node scripts/gen-citation-claim-coverage.mts",
    "corpus-evidence": "vite-node scripts/corpus-evidence.mts",
    "corpus-oracle": "python scripts/corpus-oracle.py --corpus",
    "corpus-oracle:selftest": "python scripts/corpus-oracle.py --selftest",
    "seed-program-registry": "vite-node scripts/seed-program-registry.mts",
    "reconcile-programs": "vite-node scripts/reconcile-programs.mts",
    "harvest-programs": "vite-node scripts/harvest-programs.mts",
    "match-upisnik-units": "vite-node scripts/match-upisnik-units.mts",
    "approve-unit-match": "vite-node scripts/approve-unit-match.mts",
    "repair-gap": "vite-node scripts/repair-gap-report.mts",
    "closed-loop": "vite-node scripts/run-closed-loop.mts",
    "seed-declarations": "vite-node scripts/seed-declarations.mts",
    "lint": "oxlint",
    "post-deploy-smoke": "node scripts/post-deploy-smoke.mjs",
    "post-deploy-smoke:self-test": "node scripts/post-deploy-smoke.mjs --self-test",
    "check:edge-lock": "node scripts/check-edge-lock.mjs",
    "status": "node scripts/generate-status.mjs",
    "deploy-manifest": "node scripts/generate-deploy-manifest.mjs",
    "attest-corpus": "node scripts/attest-real-corpus.mjs",
    "branch-ci": "node scripts/master-ci-status.mjs --current"
  },
  "overrides": {
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "dictionary-hr": "^2.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.13.2",
    "netlify-cli": "^26.2.0",
    "oxlint": "^1.81.0",
    "supabase": "^2.109.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@xmldom/xmldom": "^0.9.12",
    "canvas-confetti": "^1.9.4",
    "hunspell-asm": "^4.0.2",
    "lucide": "^1.40.0",
    "motion": "^12.42.2",
    "open-props": "^1.7.23"
  }
}
