{
  "name": "lekta",
  "private": true,
  "version": "2.2.2",
  "type": "module",
  "description": "Lekta - klijentska provjera akademskih radova prema profilima zagrebackih visokih ucilista.",
  "scripts": {
    "bootstrap": "node scripts/split-prototype.mjs",
    "extract-data": "node scripts/extract-data.mjs",
    "discovery": "node discovery/ingest.mjs && node discovery/generate-coverage.mjs",
    "demand-signal": "node discovery/demand-signal.mjs",
    "notify-covered": "node discovery/notify-covered.mjs",
    "recompute-coverage": "node scripts/recompute-coverage.mjs",
    "gen-corpus-stats": "node scripts/gen-corpus-stats.mjs",
    "apply-verification": "node scripts/apply-verification.mjs",
    "dossier": "node scripts/verification-dossier.mjs",
    "generate-citation-tools": "node scripts/generate-citation-tools.mjs",
    "generate-legal-pages": "node scripts/generate-legal-pages.mjs",
    "generate-coverage-page": "node scripts/generate-coverage-page.mjs",
    "generate-faculty-pages": "node scripts/generate-faculty-pages.mjs",
    "generate-title-page-tools": "node scripts/generate-title-page-tools.mjs",
    "generate-competitor-pages": "node scripts/generate-competitor-pages.mjs",
    "extract-citation-sections": "node scripts/extract-citation-sections.mjs",
    "citation-dossiers": "node scripts/citation-spec-dossier.mjs",
    "approve-citation-spec": "node scripts/approve-citation-spec.mjs",
    "gen:worktype-scope": "node scripts/generate-work-type-scope.mjs",
    "docx-smoke": "vite-node scripts/docx-smoke.mts",
    "corpus:inventory": "vite-node tests/corpus/cli/inventory.ts",
    "corpus:coverage": "vite-node tests/corpus/cli/coverage.ts",
    "corpus:export": "vite-node tests/corpus/cli/export.ts",
    "test:corpus": "vitest run tests/corpus-inventory.test.ts tests/corpus-ids.test.ts tests/corpus-atomic.test.ts tests/corpus-valid-controls.test.ts tests/corpus-boundary.test.ts tests/corpus-coverage.test.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ux": "playwright test",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "conformance": "vitest run --config vitest.conformance.config.ts",
    "check": "tsc --noEmit && vitest run && vite build",
    "check:full": "npm run check && npm run test:slow",
    "verify:strict-open": "python scripts/verify-docx/strict-open.py tests/fixtures/docx",
    "verify:word": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/check.ps1",
    "verify:word:worst": "powershell -ExecutionPolicy Bypass -File scripts/word-verify/check-worst-case.ps1",
    "repair-recipe": "vite-node scripts/generate-repair-recipe.mts",
    "repair-coverage": "vite-node scripts/generate-repair-coverage.mts",
    "repair-real-corpus": "vite-node scripts/repair-real-corpus.mts",
    "repair-real-corpus:review": "vite-node scripts/repair-real-corpus.mts --out .artifacts/lekta-real-corpus-review",
    "repair-faculty-matrix": "vite-node scripts/generate-faculty-matrix.mts",
    "pack:katedra": "vite-node scripts/generate-katedra-pack.mts",
    "generate-benchmark-fixture": "vite-node scripts/generate-benchmark-fixture.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "dictionary-hr": "^2.0.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "netlify-cli": "^26.2.0",
    "supabase": "^2.109.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.2.7",
    "@fontsource-variable/newsreader": "^5.2.10",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/caveat": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@xmldom/xmldom": "^0.9.10",
    "canvas-confetti": "^1.9.4",
    "hunspell-asm": "^4.0.2",
    "lucide": "^1.24.0",
    "motion": "^12.42.2",
    "open-props": "^1.7.23"
  }
}
