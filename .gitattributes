# Hunspell rjecnik (hrvatski pravopis): cuvaj TOCNE bajtove, bez EOL konverzije.
# Uz core.autocrlf=true git bi ih na checkoutu pretvorio u CRLF, a \r bi usao u
# affix polja (.aff) i unose (.dic) pa bi Hunspell parsiranje puklo. -text = binarno.
src/audits/hr-dict/hr_HR.aff -text
src/audits/hr-dict/hr_HR.dic -text

# Vite imports these Node ESM generator modules during tests. Keep them LF on
# every checkout; CRLF causes import-analysis to report a misleading syntax
# error from the importing test instead of the actual generator module.
*.mjs text eol=lf

# Golden snimke (vitest). Vitest ih PISE s LF, a `core.autocrlf` ih na checkoutu pretvara u CRLF,
# pa svaki prolaz u svjezem worktreeu ostavi tri datoteke koje `git status` prijavljuje kao
# izmijenjene, a sadrzaj im je bajt-identican commitanome.
#
# Izmjereno 2026-09-03: svjez checkout CR=5995/18163/3111, dijeljeno stablo CR=0. Na tu prividnu
# izmjenu naletjelo je najmanje tri sesije u jednom danu, a jedna je zamalo commitala "osvjezene"
# golden snimke, sto je nad datotekama koje su ovdje jedini dokaz zatecenog ponasanja skupo.
*.snap text eol=lf

# Generirani artefakti. Pisu ih alati s LF, a `core.autocrlf` ih na checkoutu pretvara u CRLF, pa
# svaka regeneracija u svjezem worktreeu ostavi datoteke koje `git status` prijavljuje kao
# izmijenjene iako su bajt-identicne commitanima. Izmjereno 2026-09-03/04: na tu prividnu izmjenu
# naletjelo se najmanje sest puta u jednom danu, tri puta nad golden snimkama i tri nad ovima
# (faculty-matrix, completion-ledger, real-corpus-backlog).
#
# Pravilo NISTA ne prekonvertira: sva 23 commitana artefakta su u gitu vec LF (provjereno).
# Mijenja se iskljucivo ono sto checkout upisuje na disk.
docs/generated/** text eol=lf
data/generated/** text eol=lf
# Isti razred: dosjei verifikacije (120 datoteka) pise generator s LF. Blobovi su vec LF,
# provjereno po datoteci, pa pravilo nista ne prekonvertira.
data/verification/** text eol=lf
