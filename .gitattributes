# Globalno: tekst je LF i u repozitoriju i na checkoutu, neovisno o core.autocrlf (odluka vlasnika
# 2026-10-08). CRLF je prva stavka kataloga kvarova (.claude/skills/lekta-protokol/SKILL.md): pojedinacna
# pravila nize gasila su incident po incident, ovo zatvara razred. Izmjereno 2026-10-08: indeks je vec
# LF (3707 datoteka, 0 CRLF osim jedne fixture izuzete na dnu), pa pravilo NISTA ne prekonvertira.
# Mijenja se samo ono sto checkout upisuje na disk. Posebna pravila nize i dalje vrijede (zadnje vrijedi).
* text=auto eol=lf

# Binarni formati: nikad diff ni normalizacija, i kad heuristika text=auto pogrijesi.
*.docx binary
*.doc binary
*.dotx binary
*.dot binary
*.rar binary
*.odt binary
*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Hunspell rjecnik (hrvatski pravopis): cuvaj TOCNE bajtove, bez EOL konverzije.
# Uz core.autocrlf=true git bi ih na checkoutu pretvorio u CRLF, a \r bi usao u
# affix polja (.aff) i unose (.dic) pa bi Hunspell parsiranje puklo. -text = binarno.
src/audits/hr-dict/hr_HR.aff -text
src/audits/hr-dict/hr_HR.dic -text

# Vite imports these Node ESM generator modules during tests. Keep them LF on
# every checkout; CRLF causes import-analysis to report a misleading syntax
# error from the importing test instead of the actual generator module.
*.mjs text eol=lf

# Golden snimke (vitest). Vitest ih PISE s LF, a `core.autocrlf` ih na checkoutu pretvara u CRLF,
# pa svaki prolaz u svjezem worktreeu ostavi tri datoteke koje `git status` prijavljuje kao
# izmijenjene, a sadrzaj im je bajt-identican commitanome.
#
# Izmjereno 2026-09-03: svjez checkout CR=5995/18163/3111, dijeljeno stablo CR=0. Na tu prividnu
# izmjenu naletjelo je najmanje tri sesije u jednom danu, a jedna je zamalo commitala "osvjezene"
# golden snimke, sto je nad datotekama koje su ovdje jedini dokaz zatecenog ponasanja skupo.
*.snap text eol=lf

# Generirani artefakti. Pisu ih alati s LF, a `core.autocrlf` ih na checkoutu pretvara u CRLF, pa
# svaka regeneracija u svjezem worktreeu ostavi datoteke koje `git status` prijavljuje kao
# izmijenjene iako su bajt-identicne commitanima. Izmjereno 2026-09-03/04: na tu prividnu izmjenu
# naletjelo se najmanje sest puta u jednom danu, tri puta nad golden snimkama i tri nad ovima
# (faculty-matrix, completion-ledger, real-corpus-backlog).
#
# Pravilo NISTA ne prekonvertira: sva 23 commitana artefakta su u gitu vec LF (provjereno).
# Mijenja se iskljucivo ono sto checkout upisuje na disk.
docs/generated/** text eol=lf
data/generated/** text eol=lf
# Isti razred: dosjei verifikacije (120 datoteka) pise generator s LF. Blobovi su vec LF,
# provjereno po datoteci, pa pravilo nista ne prekonvertira.
data/verification/** text eol=lf

# Vendorani program do javnog lansiranja. `docs/quality/lekta-plan-status.md` tvrdi da je ta datoteka
# bajt jednaka izvoru (sha256 `1b2af479...`), a uz `core.autocrlf=true` bi je svjez checkout
# materijalizirao s CRLF, pa bi tvrdnja pala svugdje osim na stroju na kojem je mjerena.
# Izmjereno 2026-09-12: blob je 104606 bajtova, CR=0, LF=991, pa pravilo NISTA ne prekonvertira;
# mijenja se iskljucivo ono sto checkout upisuje na disk.
docs/agents/plan-do-live-2026-09-12.md text eol=lf

# Snimke izvora Upisnika: gard citata u snimci provjerava sha256 TOCNIH bajtova prema registru, pa git ne smije
# normalizirati zavrsetke redaka (CRLF/mixed u HTML-u bi promijenio hash). -text = binarno.
data/sources/**/upisnik-*.html -text

# Snimka Crossref odgovora (tests/helpers/retraction-guard.ts, tests/t98-*.test.ts) commitana je s CRLF:
# cuvaj tocne bajtove da je svaki stroj cita jednako. Jedina CRLF datoteka u indeksu na dan 2026-10-08.
tests/fixtures/crossref/select-with-authors.json -text

# Sve snimke izvora: gardovi citata provjeravaju sha256 tocnih bajtova prema registru (vidi pravilo za
# upisnik-*.html gore), pa git ni na checkoutu ne smije dirati njihove krajeve redaka.
data/sources/** -text
